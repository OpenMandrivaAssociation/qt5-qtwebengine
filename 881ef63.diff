diff --git a/src/3rdparty/gn/tools/gn/ninja_action_target_writer.cc b/src/3rdparty/gn/tools/gn/ninja_action_target_writer.cc
--- a/src/3rdparty/gn/tools/gn/ninja_action_target_writer.cc
+++ b/src/3rdparty/gn/tools/gn/ninja_action_target_writer.cc
@@ -119,6 +119,27 @@
     // strictly necessary for regular one-shot actions, but it's easier to
     // just always define unique_name.
     std::string rspfile = custom_rule_name;
+
+    // NAME_MAX is 255. Keep the path unique when it has to be shortened:
+    // cutting the tail drops the toolchain, so the host and target copies of
+    // one action share a rspfile. Ninja deletes that file when the first
+    // copy finishes and the other fails with ENOENT.
+    const size_t kRspBudget = 240;
+    if (rspfile.length() > kRspBudget) {
+      unsigned long long hash = 14695981039346656037ull;
+      for (size_t i = 0; i < custom_rule_name.size(); ++i) {
+        hash ^= static_cast<unsigned char>(custom_rule_name[i]);
+        hash *= 1099511628211ull;
+      }
+      static const char kHex[] = "0123456789abcdef";
+      std::string hex(16, '0');
+      for (int i = 15; i >= 0; --i) {
+        hex[static_cast<size_t>(i)] = kHex[hash & 0xf];
+        hash >>= 4;
+      }
+      rspfile = rspfile.substr(0, kRspBudget - 17) + "_" + hex;
+    }
+
     if (!target_->sources().empty())
       rspfile += ".$unique_name";
     rspfile += ".rsp";
