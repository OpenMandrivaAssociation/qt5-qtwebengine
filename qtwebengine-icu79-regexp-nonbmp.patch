+// Unicode 18 case closures of BMP characters can contain supplementary
+// code points (U+1DF95 case-folds to U+00DF). Canonicalize() is only
+// defined for UTF-16 code units, and non-unicode ignoreCase matching
+// never compares a supplementary code point with a BMP character.
+static void RemoveSupplementary(icu::UnicodeSet& set) {
+  set.remove(static_cast<UChar32>(kNonBmpStart), 0x10ffff);
+}
